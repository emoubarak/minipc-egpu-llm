#!/usr/bin/env python3
"""serve-bench: measure a llama-server configuration the way you will actually use it.

llama-bench cannot run speculative decoding (MTP, DFlash, draft models), so every
MTP number in this repo comes from llama-server. This script starts one server with
the flags you give it, on a free port with its own log file, sends the same request
several times and reports generation speed, prompt speed and draft acceptance from
the server's own `timings` object.

    serve-bench [options] -- <llama-server args>

    serve-bench -- -m model.gguf -ngl 99 -fa on -ctk q8_0 -ncmoe 33 \\
                   --spec-type draft-mtp --spec-draft-n-max 2

Options:
    --server PATH       llama-server binary (default: $LLAMA_SERVER, else
                        $LLAMA_DIR/build/bin/llama-server, else llama-server on PATH)
    --mode MODE         completion (default, /completion) or chat (/v1/chat/completions)
    --prompt TEXT       prompt text (default: "Write a short poem about GPU programming.")
    --prompt-file PATH  read the prompt from a file (for long-prompt tests)
    --n-predict N       tokens to generate (default 200)
    --runs N            measured runs (default 3)
    --warmup N          unmeasured runs first (default 1)
    --csv PATH          append one row per measured run to a CSV file
    --label TEXT        free-form label written to the CSV
    --timeout S         seconds to wait for the model to load (default 600)

Only the Python standard library is used.
"""
import argparse
import csv
import datetime as dt
import json
import os
import shutil
import socket
import statistics
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

DEFAULT_PROMPT = "Write a short poem about GPU programming."


def find_server(explicit):
    if explicit:
        return explicit
    if os.environ.get("LLAMA_SERVER"):
        return os.environ["LLAMA_SERVER"]
    llama_dir = os.environ.get("LLAMA_DIR", os.path.expanduser("~/llama.cpp"))
    candidate = os.path.join(llama_dir, "build", "bin", "llama-server")
    if os.access(candidate, os.X_OK):
        return candidate
    found = shutil.which("llama-server")
    if found:
        return found
    sys.exit("serve-bench: llama-server not found (use --server, LLAMA_SERVER or LLAMA_DIR)")


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def http(url, payload=None, timeout=900):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def wait_ready(base, proc, timeout, log_path):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if proc.poll() is not None:
            sys.exit(f"serve-bench: llama-server exited with code {proc.returncode}, see {log_path}")
        try:
            if http(base + "/health", timeout=2).get("status") == "ok":
                return
        except (urllib.error.URLError, ConnectionError, TimeoutError, json.JSONDecodeError):
            pass
        time.sleep(1)
    sys.exit(f"serve-bench: server not ready after {timeout} s, see {log_path}")


def one_request(base, mode, prompt, n_predict):
    if mode == "chat":
        body = {"messages": [{"role": "user", "content": prompt}], "max_tokens": n_predict,
                "temperature": 0, "stream": False, "cache_prompt": False}
        resp = http(base + "/v1/chat/completions", body)
    else:
        body = {"prompt": prompt, "n_predict": n_predict, "temperature": 0, "stream": False,
                "cache_prompt": False}
        resp = http(base + "/completion", body)
    t = resp.get("timings") or {}
    acc = None
    if t.get("draft_n"):
        acc = t.get("draft_n_accepted", 0) / t["draft_n"]
    return {
        "prompt_n": t.get("prompt_n"),
        "pp": t.get("prompt_per_second"),
        "predicted_n": t.get("predicted_n"),
        "tg": t.get("predicted_per_second"),
        "acceptance": acc,
    }


def fmt(values, digits=1):
    vals = [v for v in values if v is not None]
    if not vals:
        return "n/a"
    if len(vals) == 1:
        return f"{vals[0]:.{digits}f}"
    return f"{statistics.median(vals):.{digits}f} (min {min(vals):.{digits}f}, max {max(vals):.{digits}f})"


def main():
    argv = sys.argv[1:]
    if "--" not in argv:
        print(__doc__)
        sys.exit(2)
    split = argv.index("--")
    ours, server_args = argv[:split], argv[split + 1:]
    if not server_args:
        sys.exit("serve-bench: no llama-server arguments after --")

    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--server")
    ap.add_argument("--mode", choices=("completion", "chat"), default="completion")
    ap.add_argument("--prompt", default=DEFAULT_PROMPT)
    ap.add_argument("--prompt-file")
    ap.add_argument("--n-predict", type=int, default=200)
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--warmup", type=int, default=1)
    ap.add_argument("--csv")
    ap.add_argument("--label", default="")
    ap.add_argument("--timeout", type=int, default=600)
    ap.add_argument("-h", "--help", action="store_true")
    opts = ap.parse_args(ours)
    if opts.help:
        print(__doc__)
        return

    for flag in ("--port", "--host", "--log-file"):
        if flag in server_args:
            sys.exit(f"serve-bench: do not pass {flag}, serve-bench sets it")

    prompt = open(opts.prompt_file).read() if opts.prompt_file else opts.prompt
    server = find_server(opts.server)
    port = free_port()
    log_fd, log_path = tempfile.mkstemp(prefix=f"serve-bench-{port}-", suffix=".log")
    os.close(log_fd)
    cmd = [server, *server_args, "--host", "127.0.0.1", "--port", str(port), "--log-file", log_path]
    print("server :", " ".join(cmd), file=sys.stderr)

    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    base = f"http://127.0.0.1:{port}"
    results = []
    try:
        wait_ready(base, proc, opts.timeout, log_path)
        for i in range(opts.warmup + opts.runs):
            r = one_request(base, opts.mode, prompt, opts.n_predict)
            measured = i >= opts.warmup
            tag = f"run {i - opts.warmup + 1}" if measured else "warm-up"
            acc = f", acceptance {r['acceptance']:.3f}" if r["acceptance"] is not None else ""
            print(f"{tag:8}: prompt {r['prompt_n']} tok at {r['pp'] or 0:.1f} t/s, "
                  f"generated {r['predicted_n']} tok at {r['tg'] or 0:.1f} t/s{acc}", file=sys.stderr)
            if measured:
                results.append(r)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=30)
        except subprocess.TimeoutExpired:
            proc.kill()

    print()
    print(f"generation : {fmt([r['tg'] for r in results])} t/s")
    print(f"prompt     : {fmt([r['pp'] for r in results])} t/s ({results[0]['prompt_n']} tokens)")
    if any(r["acceptance"] is not None for r in results):
        print(f"acceptance : {fmt([r['acceptance'] for r in results], 3)}")
    print(f"log        : {log_path}")

    if opts.csv:
        new = not os.path.exists(opts.csv)
        with open(opts.csv, "a", newline="") as f:
            w = csv.writer(f)
            if new:
                w.writerow(["timestamp", "label", "mode", "prompt_n", "pp", "predicted_n", "tg", "acceptance", "args"])
            now = dt.datetime.now().isoformat(timespec="seconds")
            for r in results:
                w.writerow([now, opts.label, opts.mode, r["prompt_n"], r["pp"], r["predicted_n"], r["tg"],
                            r["acceptance"], " ".join(server_args)])


if __name__ == "__main__":
    main()
